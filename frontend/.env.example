# Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Neon PostgreSQL connection (direct, for Better Auth)
DATABASE_URL=postgresql://user:pass@ep-xxx.region.neon.tech/dbname?sslmode=require

# Better Auth secret (generate a random 32+ character string)
BETTER_AUTH_SECRET=your-random-secret-here-minimum-32-characters

# Better Auth base URL
BETTER_AUTH_URL=http://localhost:3000
