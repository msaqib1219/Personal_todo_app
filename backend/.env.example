# Neon PostgreSQL connection (use pooled endpoint with -pooler suffix)
DATABASE_URL=postgresql+psycopg://user:pass@ep-xxx-pooler.region.neon.tech/dbname?sslmode=require

# Better Auth JWKS endpoint (frontend URL + /api/auth/jwks)
JWKS_URL=http://localhost:3000/api/auth/jwks

# Frontend origin for CORS
FRONTEND_URL=http://localhost:3000

# Log file path (optional, defaults to ~/.todo-app-web/app.log)
LOG_FILE=~/.todo-app-web/app.log
